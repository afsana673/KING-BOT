# Rename to .env for local use (dotenv loads .env automatically).
# On Railway, add these in the service's Variables screen.
PREFIX=.
BOT_NAME=SK Goat Bot
ADMIN_IDS=61595276322537
# Recommended: paste the full exported JSON array into Railway APPSTATE_JSON.
# APPSTATE_JSON=[{"key":"c_user","value":"...","domain":".facebook.com","path":"/"},...]
# Alternative: cookie header copied from YOUR OWN logged-in Facebook account:
# FB_COOKIE=c_user=123456789; xs=YOUR_SESSION_VALUE; datr=OPTIONAL
# If both are missing, the bot searches data/appstate.json, appstate.json, apostate.json.
# Optional persistent data location; otherwise Railway volume mount path is used.
# DATA_DIR=/app/data
# Railway supplies PORT automatically.
# PORT=3000
COOLDOWN_MS=1500
